{"version":3,"names":[],"sources":["jsx-classic.tsx"],"sourcesContent":["import * as React from \"react\";\ninterface Props {\n  name: string;\n}\nexport function Hello({ name }: Props) {\n  return (\n    <>\n      <h1 className=\"title\">Hello, {name}!</h1>\n      <Greeting {...{ name }} key=\"k\" />\n      {/* a comment */}\n      <input disabled value={name as string} />\n    </>\n  );\n}\nfunction Greeting(props: Props) {\n  return <p>{props.name}</p>;\n}\n"],"mappings":"AAAA,YAAY,WAAW;AAIvB,OAAO,SAAS,MAAM,EAAE,QAAe;CACrC,OACE,0DACE,oCAAC,MAAD,EAAI,WAAU,QAA0B,GAAlB,WAAQ,MAAK,GAAK,GACxC,oCAAC,UAAD;EAAgB;EAAQ,KAAI;CAAK,IAEjC,oCAAC,SAAD;EAAO;EAAS,OAAO;CAAiB,EACxC;AAEN;AACA,SAAS,SAAS,OAAc;CAC9B,OAAO,oCAAC,WAAG,MAAM,IAAQ;AAC3B"}

export class Account {
	id;
	owner;
	override_;
	balance = 0;
	constructor(id, owner, override_, plain = 1) {
		this.id = id;
		this.owner = owner;
		this.override_ = override_;
		this.balance = plain;
	}
}
class Base {
	name;
	constructor(name) {
		this.name = name;
	}
}
export class Child extends Base {
	age;
	extra = "x";
	constructor(name, age) {
		super(name);
		this.age = age;
	}
}
